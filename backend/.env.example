# FinanceMe — Backend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=development

# Port the backend listens on (Nginx proxies /api → this port)
PORT=3001

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret

# ─── Optional ────────────────────────────────────────────────────────────────

# Anthropic API key — only needed for credit card PDF statement import.
# CSV imports from major banks (Chase, Citi, Capital One, BofA) are parsed
# locally for free. Only unknown CSV formats and PDF statements use Claude.
# Get your key at: https://console.anthropic.com
# Cost: ~$0.001–$0.01 per PDF import using claude-haiku-4-5 model
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Plaid (Bank Account Sync) ───────────────────────────────────────────────
# Required only for the "Connected Accounts" Plaid integration.
# Sign up free at: https://dashboard.plaid.com
# Use 'sandbox' for testing, 'development' for real accounts (free up to 100),
# 'production' for live deployment.
# PLAID_CLIENT_ID=your_client_id
# PLAID_SECRET=your_sandbox_or_development_secret
# PLAID_ENV=sandbox
